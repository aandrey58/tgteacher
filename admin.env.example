# Copy to admin.env and chmod 600. Use openssl rand -hex 32; never reuse MCP credentials.
WEB_ADMIN_SECRET=
WEB_ADMIN_ORIGIN=http://127.0.0.1:8080

# Disable only after creating and testing a personal owner account.
WEB_ADMIN_ALLOW_RECOVERY=1

# Optional AI providers for web-admin only. Copy approved provider settings from
# mcp.env if upgrading; do not copy TGTEACHER_MCP_* credentials or BOT_TOKEN.
OPENROUTER_API_KEY=
KODIK_API_KEY=
TIMEWEB_AI_TOKEN=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
TGTEACHER_TTS_GATEWAY_MODELS={}
TGTEACHER_IMAGE_MODELS={}
TGTEACHER_TTS_DAILY_MICROUSD=0
TGTEACHER_IMAGE_DAILY_MICROUSD=0
TGTEACHER_TTS_OPENAI_MICROUSD_PER_BYTE=
TGTEACHER_TTS_ELEVENLABS_MICROUSD_PER_BYTE=
TGTEACHER_TTS_OPENAI_VOICES=
TGTEACHER_TTS_ELEVENLABS_VOICES=
