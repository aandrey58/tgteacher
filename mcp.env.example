# Copy to mcp.env. Local static bearer mode for smoke testing.
TGTEACHER_MCP_AUTH_MODE=static
TGTEACHER_MCP_RESOURCE_URL=http://127.0.0.1:8000/mcp
TGTEACHER_MCP_ISSUER_URL=http://127.0.0.1:8000
# Three different secrets, each >=32 ASCII characters, not starting with tgtl_.
TGTEACHER_MCP_READ_TOKEN=
TGTEACHER_MCP_EDIT_TOKEN=
TGTEACHER_MCP_PUBLISH_TOKEN=
# External OAuth mode (requires real authorization server; see docs).
# Introspection contract: active, exact iss/aud, sub, client_id, future exp, content scopes.
# Learner OAuth is opt-in; mixed learner/content scopes are rejected.
TGTEACHER_LEARNER_OAUTH_ENABLED=0
TGTEACHER_MCP_INTROSPECTION_URL=
TGTEACHER_MCP_CLIENT_ID=
TGTEACHER_MCP_CLIENT_SECRET=
OPENROUTER_API_KEY=
KODIK_API_KEY=
TIMEWEB_AI_TOKEN=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
TGTEACHER_TTS_GATEWAY_MODELS={}
TGTEACHER_IMAGE_MODELS={}
TGTEACHER_TTS_DAILY_MICROUSD=0
TGTEACHER_IMAGE_DAILY_MICROUSD=0
TGTEACHER_TTS_OPENAI_MICROUSD_PER_BYTE=
TGTEACHER_TTS_ELEVENLABS_MICROUSD_PER_BYTE=
TGTEACHER_TTS_ELEVENLABS_VOICES=
