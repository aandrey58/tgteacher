# Copy to .env; use a unique high-entropy password, never commit.
POSTGRES_USER=tgteacher
POSTGRES_DB=tgteacher
POSTGRES_PASSWORD=
MCP_HOST_PORT=8000

# During web migration keep legacy admin enabled; set 0 after acceptance.
TGTEACHER_LEGACY_ADMIN=1
TGTEACHER_WEB_ADMIN_URL=
ADMIN_HOST_PORT=8080

# Enable only when web support inbox is staffed; otherwise keep legacy Telegram help routing.
TGTEACHER_WEB_SUPPORT=0
